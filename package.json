{
  "name": "vscode-remote-tensorlake",
  "displayName": "Remote Tensorlake",
  "description": "Manage Tensorlake sandboxes and open lightweight remote workspaces without VS Code Server.",
  "version": "0.0.16",
  "repository": {
    "type": "git",
    "url": "https://github.com/starfall-org/remote-sandbox-vscode.git"
  },
  "license": "GPL-3.0-only",
  "publisher": "starfall-orbit",
  "engines": {
    "vscode": "^1.80.0"
  },
  "categories": [
    "Other"
  ],
  "activationEvents": [
    "onFileSystem:tensorlake",
    "onView:remote-tensorlake-sandboxes-sidebar",
    "onTerminalProfile:remote-tensorlake.terminal",
    "onStartupFinished"
  ],
  "extensionKind": [
    "ui"
  ],
  "main": "./out/extension.js",
  "contributes": {
    "viewsContainers": {
      "activitybar": [
        {
          "id": "remote-tensorlake",
          "title": "Remote Tensorlake",
          "icon": "$(cloud)"
        }
      ],
      "panel": [
        {
          "id": "remote-tensorlake-ports-panel",
          "title": "Ports",
          "icon": "media/ports.svg"
        }
      ]
    },
    "views": {
      "remote-tensorlake": [
        {
          "id": "remote-tensorlake-sandboxes-sidebar",
          "name": "Sandboxes",
          "type": "tree",
          "when": "true",
          "icon": "$(server)"
        }
      ],
      "remote-tensorlake-ports-panel": [
        {
          "id": "remote-tensorlake-ports",
          "name": "Ports",
          "type": "tree",
          "when": "remoteTensorlake.connected"
        }
      ]
    },
    "commands": [
      {
        "command": "remote-tensorlake.refreshSandboxes",
        "title": "Refresh Sandboxes",
        "icon": "$(refresh)"
      },
      {
        "command": "remote-tensorlake.tensorlakeSetApiKey",
        "title": "Tensorlake: Set API Key"
      },
      {
        "command": "remote-tensorlake.tensorlakeCreateSandbox",
        "title": "Tensorlake: Create Sandbox",
        "icon": "$(add)"
      },
      {
        "command": "remote-tensorlake.tensorlakeSuspendSandbox",
        "title": "Tensorlake: Suspend Sandbox",
        "icon": "$(debug-pause)"
      },
      {
        "command": "remote-tensorlake.tensorlakeResumeSandbox",
        "title": "Tensorlake: Resume Sandbox",
        "icon": "$(debug-start)"
      },
      {
        "command": "remote-tensorlake.tensorlakeDeleteSandbox",
        "title": "Tensorlake: Terminate Sandbox",
        "icon": "$(trash)"
      },
      {
        "command": "remote-tensorlake.tensorlakeListSandboxes",
        "title": "Tensorlake: Connect"
      },
      {
        "command": "remote-tensorlake.connectInCurrentWindow",
        "title": "Connect in Current Window",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-tensorlake.connectInNewWindow",
        "title": "Connect in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-tensorlake.openTerminal",
        "title": "Tensorlake: Open Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "remote-tensorlake.openTerminalAtPath",
        "title": "Open in Tensorlake Terminal",
        "icon": "$(terminal)"
      },
      {
        "command": "remote-tensorlake.exposePublicPort",
        "title": "Tensorlake: Expose Public Port",
        "icon": "$(globe)"
      },
      {
        "command": "remote-tensorlake.openConnectedFolder",
        "title": "Tensorlake: Open Folder...",
        "icon": "$(folder-opened)"
      },
      {
        "command": "remote-tensorlake.cloneGitRepository",
        "title": "Tensorlake: Clone Git Repository...",
        "icon": "$(repo-clone)"
      },
      {
        "command": "remote-tensorlake.refreshPorts",
        "title": "Refresh Ports",
        "icon": "$(refresh)"
      },
      {
        "command": "remote-tensorlake.openPort",
        "title": "Open in Browser",
        "icon": "$(link-external)"
      },
      {
        "command": "remote-tensorlake.copyPortUrl",
        "title": "Copy Port URL",
        "icon": "$(copy)"
      },
      {
        "command": "remote-tensorlake.showLogs",
        "title": "Tensorlake: Show Logs",
        "icon": "$(output)"
      },
      {
        "command": "remote-tensorlake.removePort",
        "title": "Remove Public Port",
        "icon": "$(close)"
      },
      {
        "command": "remote-tensorlake.connectRecentFolderInCurrentWindow",
        "title": "Connect in Current Window",
        "icon": "$(arrow-right)"
      },
      {
        "command": "remote-tensorlake.connectRecentFolderInNewWindow",
        "title": "Connect in New Window",
        "icon": "$(empty-window)"
      },
      {
        "command": "remote-tensorlake.removeRecentFolder",
        "title": "Remove from Recent",
        "icon": "$(close)"
      }
    ],
    "menus": {
      "view/title": [
        {
          "command": "remote-tensorlake.exposePublicPort",
          "when": "view == remote-tensorlake-ports",
          "group": "navigation@1"
        },
        {
          "command": "remote-tensorlake.refreshPorts",
          "when": "view == remote-tensorlake-ports",
          "group": "navigation@2"
        },
        {
          "command": "remote-tensorlake.tensorlakeCreateSandbox",
          "when": "view == remote-tensorlake-sandboxes-sidebar",
          "group": "navigation@1"
        },
        {
          "command": "remote-tensorlake.refreshSandboxes",
          "when": "view == remote-tensorlake-sandboxes-sidebar",
          "group": "navigation@2"
        }
      ],
      "view/item/context": [
        {
          "command": "remote-tensorlake.tensorlakeSuspendSandbox",
          "when": "viewItem == tensorlakeSandboxRunning && view == remote-tensorlake-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-tensorlake.tensorlakeResumeSandbox",
          "when": "viewItem == tensorlakeSandboxSuspended && view == remote-tensorlake-sandboxes-sidebar",
          "group": "inline@0"
        },
        {
          "command": "remote-tensorlake.connectInCurrentWindow",
          "when": "viewItem =~ /tensorlakeSandbox(Running.*|Suspended)/ && view == remote-tensorlake-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-tensorlake.connectInNewWindow",
          "when": "viewItem =~ /tensorlakeSandbox(Running.*|Suspended)/ && view == remote-tensorlake-sandboxes-sidebar",
          "group": "inline@2"
        },
        {
          "command": "remote-tensorlake.tensorlakeDeleteSandbox",
          "when": "viewItem =~ /tensorlakeSandbox/ && view == remote-tensorlake-sandboxes-sidebar",
          "group": "3_delete@1"
        },
        {
          "command": "remote-tensorlake.exposePublicPort",
          "when": "viewItem =~ /tensorlakeSandbox(Running.*|Suspended)/ && view == remote-tensorlake-sandboxes-sidebar",
          "group": "2_network@1"
        },
        {
          "command": "remote-tensorlake.openPort",
          "when": "view == remote-tensorlake-ports && viewItem == tensorlakePort",
          "group": "inline@1"
        },
        {
          "command": "remote-tensorlake.copyPortUrl",
          "when": "view == remote-tensorlake-ports && viewItem == tensorlakePort",
          "group": "inline@2"
        },
        {
          "command": "remote-tensorlake.openTerminal",
          "when": "viewItem =~ /tensorlakeSandbox(Running.*|Suspended)/ && view == remote-tensorlake-sandboxes-sidebar",
          "group": "1_actions@3"
        },
        {
          "command": "remote-tensorlake.connectRecentFolderInCurrentWindow",
          "when": "viewItem == tensorlakeRecentFolder && view == remote-tensorlake-sandboxes-sidebar",
          "group": "inline@1"
        },
        {
          "command": "remote-tensorlake.removeRecentFolder",
          "when": "viewItem == tensorlakeRecentFolder && view == remote-tensorlake-sandboxes-sidebar",
          "group": "inline@9"
        },
        {
          "command": "remote-tensorlake.connectRecentFolderInNewWindow",
          "when": "viewItem == tensorlakeRecentFolder && view == remote-tensorlake-sandboxes-sidebar",
          "group": "1_actions@2"
        },
        {
          "command": "remote-tensorlake.removePort",
          "when": "view == remote-tensorlake-ports && viewItem == tensorlakePort",
          "group": "inline@9"
        }
      ],
      "explorer/context": [
        {
          "command": "remote-tensorlake.openTerminalAtPath",
          "when": "resourceScheme == tensorlake && explorerResourceIsFolder",
          "group": "navigation@10"
        }
      ]
    },
    "configuration": {
      "title": "Remote Tensorlake",
      "properties": {
        "remoteTensorlake.tensorlakeApiKey": {
          "type": "string",
          "default": "",
          "editPresentation": "password",
          "markdownDescription": "Your [Tensorlake](https://tensorlake.ai) API key. The extension uses it for sandbox lifecycle and lightweight remote operations. You can also use `TENSORLAKE_API_KEY`.",
          "scope": "application"
        }
      }
    },
    "terminal": {
      "profiles": [
        {
          "id": "remote-tensorlake.terminal",
          "title": "Tensorlake",
          "icon": "cloud"
        }
      ]
    },
    "viewsWelcome": [
      {
        "view": "remote-tensorlake-ports",
        "contents": "No exposed Tensorlake ports.\n\n[Forward a Port](command:remote-tensorlake.exposePublicPort)",
        "when": "remoteTensorlake.connected"
      }
    ]
  },
  "scripts": {
    "vscode:prepublish": "npm run compile",
    "compile": "tsc -p ./",
    "watch": "tsc -watch -p ./"
  },
  "devDependencies": {
    "@types/node": "^20.19.43",
    "@types/vscode": "^1.80.0",
    "@types/ws": "^8.18.1",
    "@vscode/vsce": "^3.9.2",
    "typescript": "^5.3.3"
  },
  "dependencies": {
    "ws": "^8.22.0"
  }
}
